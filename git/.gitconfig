# Machine-specific settings (e.g. user.email) go in ~/.gitconfig.local,
# which is included at the bottom so it overrides anything here.

[user]
	name = Jesson Yo

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true        # n / N to jump between files
	line-numbers = true
	side-by-side = false   # one-off: git diff --side-by-side ... or DELTA_FEATURES=+side-by-side
	syntax-theme = Dracula
	dark = true            # don't auto-detect; light mode makes added lines unreadable

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default

[include]
	path = ~/.gitconfig.local
